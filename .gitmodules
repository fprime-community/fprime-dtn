[submodule "lib/fprime"]
	path = lib/fprime
	url = https://github.com/nasa/fprime.git
	branch = devel
[submodule "lib/fprime-arm-linux"]
	path = lib/fprime-arm-linux
	url = https://github.com/LeStarch/fprime-arm-linux.git
[submodule "lib/fprime-gds-dtn"]
	path = lib/fprime-gds-dtn
	url = https://github.com/pcrosemurgy/fprime-gds-dtn.git
	branch = devel
[submodule "lib/pyion"]
	path = lib/pyion
	url = https://github.com/nasa-jpl/pyion.git
	branch = v4.2.0-b
[submodule "lib/ion"]
	path = lib/ion
	url = https://github.com/nasa-jpl/ion-dtn.git
	update = none # Manually set to `ion-open-source-4.2.0-b` tag
[submodule "lib/ion-core"]
	path = lib/ion-core
	url = https://github.com/nasa-jpl/ion-core.git # tag 4.2.0-b; carries ION at external/ION-DTN
